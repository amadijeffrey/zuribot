{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    { "path": "/internal/cron/sweep", "schedule": "0 3 * * *" },
    { "path": "/internal/cron/worksheet-reminders", "schedule": "0 3 1 * *" },
    { "path": "/internal/cron/premium-upgrade-nudge", "schedule": "10 3 1 * *" }
  ]
}
